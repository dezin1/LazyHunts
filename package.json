{
  "name": "huntera-multiconta",
  "version": "0.13.6",
  "description": "App desktop (Electron) não-oficial pra manter várias contas do Huntera logadas em paralelo, cada uma isolada, numa janela só. Projeto de aprendizado — inspirado no HunteraFarm (descontinuado), reescrito do zero.",
  "private": true,
  "main": "main.js",
  "author": "André Pinheiro Schulz",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "publish": "node scripts/publicar.mjs",
    "commit": "node scripts/commit.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder --mac --win",
    "verify:version": "node scripts/verificar-versao.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "javascript-obfuscator": "^4.2.2"
  },
  "build": {
    "appId": "br.com.andre.hunteramulticonta",
    "productName": "LazyHunts",
    "icon": "build/icon",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "automation/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://dl.lazyhunts.com"
      },
      {
        "provider": "github",
        "owner": "dezin1",
        "repo": "MultiAccount",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis-web",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "LazyHunts-Setup.exe"
    },
    "directories": {
      "output": "dist-novo"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "LazyHunts-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "LazyHunts-mac-${arch}.dmg",
      "title": "LazyHunts ${version}"
    },
    "detectUpdateChannel": false
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
